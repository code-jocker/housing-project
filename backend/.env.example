NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/housingconnect?schema=public
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=*
